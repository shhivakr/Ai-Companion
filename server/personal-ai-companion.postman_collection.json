              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401\", function () {",
                  "    pm.expect(pm.response.code).to.eql(401);",
